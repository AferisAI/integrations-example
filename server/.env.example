FRONTEND_URL=http://localhost:3000
SESSION_SECRET=change-this-local-development-secret
COOKIE_SECURE=false
AFERIS_API_URL=https://api.aferis.ai

# Valores fornecidos na configuração OAuth da Aferisai.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTH_SCOPE=
OAUTH_TOKEN_AUTH_METHOD=client_secret_basic

# O catálogo legal e os SHA-256 canônicos são lidos da API Aferis.
